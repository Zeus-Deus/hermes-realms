+            _restore_or_build_system_prompt(agent, None, [])
+            block, args = _pre_tool_block(agent, _ToolCallRef("terminal", {"command": "true"}, task, "call-1", []))
+            assert block is None
+            payload = receipts(home, "pre_tool_call")[-1]
